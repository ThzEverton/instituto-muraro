{
  "name": "instituto-muraro-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/servidor.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/servidor.js",
    "banco:gerar": "prisma generate --schema prisma/schema.prisma",
    "banco:migrar": "prisma migrate deploy --schema prisma/schema.prisma",
    "administrador:criar": "tsx src/utilitarios/criar-administrador.ts",
    "test": "vitest run tests",
    "comunicacao:gerar": "tsx src/utilitarios/gerar-fila.ts"
  }
}
