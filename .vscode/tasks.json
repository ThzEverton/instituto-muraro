{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend: executar local",
      "type": "shell",
      "command": "corepack pnpm dev --port 4173",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Frontend: verificar TypeScript",
      "type": "shell",
      "command": "corepack pnpm exec tsc --noEmit",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$tsc"
    },
    {
      "label": "Frontend: compilar",
      "type": "shell",
      "command": "corepack pnpm build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}